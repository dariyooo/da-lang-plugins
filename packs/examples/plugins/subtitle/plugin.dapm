{
  "id": "da.examples.subtitle",
  "name": "Subtitle Example",
  "version": "0.5.0",
  "runtime": "webview",
  "family": "browserPlugin",
  "needs": {},
  "kind": "subtitle",
  "description": "Reference subtitle plugin — a site-agnostic starting point: reads [data-subtitle] / <p> captions, emits the <video> clock via da.emit('playback'), and registers play/pause/seek. Works on any page with a <video>.",
  "author": "DaLang",
  "hosts": ["<all_urls>"],
  "settings": [
    {
      "key": "enabled",
      "type": "bool",
      "label": "Enable subtitles",
      "default": true
    },
    {
      "key": "language",
      "type": "choice",
      "label": "Language",
      "options": ["ja", "zh", "ko", "en"],
      "default": "ja"
    }
  ]
}
