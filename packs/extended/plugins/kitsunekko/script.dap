// Fetches Japanese subtitles from kitsunekko.net by scraping its directory
// listing. Search matches show folders by name, then lists each folder's
// parseable files as candidates. No account needed.
class SubtitleFetchPlugin {
  constructor() {
    this.base = "https://kitsunekko.net";
    this.root = "/dirlist.php?dir=subtitles%2Fjapanese%2F";
    this.maxFolders = 25;
    this.maxFiles = 300;
  }

  headers() {
    return { "User-Agent": "Mozilla/5.0" };
  }

  // Series only — matching folders; episodes are fetched lazily by listEpisodes.
  async searchSubtitles(text, opts) {
    var tokens = normalize(text).split(" ").filter(function (t) { return t; });
    if (!tokens.length) return [];
    var rootRes = await new Client().get(this.base + this.root, this.headers());
    if (rootRes.statusCode !== 200) return [];
    var anchors = new Document(rootRes.body).getElementsByTagName("a");
    var series = [];
    for (var i = 0; i < anchors.length && series.length < this.maxFolders; i++) {
      var href = anchors[i].attr("href") || "";
      var name = anchors[i].text.trim();
      if (href.indexOf("dirlist.php") >= 0 && name && matchesTokens(normalize(name), tokens)) {
        series.push({ id: href, title: name });
      }
    }
    return series;
  }

  async listEpisodes(seriesId) {
    var url = String(seriesId).indexOf("http") === 0 ? seriesId : this.base + seriesId;
    var res = await new Client().get(url, this.headers());
    if (res.statusCode !== 200) return [];
    var fileAnchors = new Document(res.body).getElementsByTagName("a");
    var episodes = [];
    for (var k = 0; k < fileAnchors.length && episodes.length < this.maxFiles; k++) {
      var fhref = fileAnchors[k].attr("href") || "";
      if (fhref.indexOf("subtitles/japanese/") < 0) continue;
      var ext = extOf(fhref);
      if (ext !== "srt" && ext !== "ass" && ext !== "ssa" && ext !== "vtt") continue;
      var fileName = fileAnchors[k].text.trim();
      episodes.push({
        id: fhref,
        title: fileName,
        language: "ja",
        season: parseSeason(fileName),
        episode: parseEpisode(fileName),
      });
    }
    return episodes;
  }

  async getSubtitle(id) {
    var path = String(id).replace(/^\/+/, "");
    var url = String(id).indexOf("http") === 0 ? id : this.base + "/" + encodeURI(path);
    var res = await new Client().get(url, this.headers());
    return { content: res.body, format: extOf(id), language: "ja" };
  }
}

function extOf(name) {
  var clean = String(name).split("?")[0].split("#")[0];
  var dot = clean.lastIndexOf(".");
  return dot >= 0 ? clean.substring(dot + 1).toLowerCase() : "srt";
}

// Lowercase; every run of non-alphanumeric (keeping kana/kanji) becomes a space.
function normalize(s) {
  return String(s).toLowerCase().replace(/[^0-9a-z぀-ヿ一-鿿]+/g, " ").trim();
}

// True when every query token appears in the normalized name.
function matchesTokens(normalizedName, tokens) {
  for (var i = 0; i < tokens.length; i++) {
    if (normalizedName.indexOf(tokens[i]) < 0) return false;
  }
  return true;
}

// Best-effort episode/season number from a show or file name.
function parseEpisode(name) {
  var s = String(name);
  var m = s.match(/[sS]\d{1,2}[\s._-]*[eE](\d{1,3})/); // S01E08
  if (m) return parseInt(m[1], 10);
  m = s.match(/(?:^|[\s._\-\[(#])(?:e|ep|episode)[\s._]*?(\d{1,3})(?=\D|$)/i); // E08 / Ep 8
  if (m) return parseInt(m[1], 10);
  m = s.match(/第\s*(\d{1,3})\s*話/); // 第08話
  if (m) return parseInt(m[1], 10);
  m = s.match(/[\s._][-–][\s._]*(\d{1,3})(?=\D|$)/); // " - 08"
  if (m) return parseInt(m[1], 10);
  return null;
}

function parseSeason(name) {
  var s = String(name);
  var m = s.match(/[sS](\d{1,2})[\s._-]*[eE]\d{1,3}/); // S02E08
  if (m) return parseInt(m[1], 10);
  m = s.match(/(?:season|series)[\s._]*(\d{1,2})/i); // Season 3
  if (m) return parseInt(m[1], 10);
  m = s.match(/(\d{1,2})\s*期/); // 3期
  if (m) return parseInt(m[1], 10);
  return null;
}
