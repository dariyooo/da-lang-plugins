(function () {
  var cfg = { enabled: true, language: 'ja' };
  var SELECTOR = '.ytp-caption-segment';
  var _lastText = '';
  var _observer = null;
  var _video = null;

  // ── Captions (YouTube-specific DOM) ─────────────────────────────────────────

  function readAndEmit() {
    if (!cfg.enabled) return;
    try {
      var nodes = document.querySelectorAll(SELECTOR);
      if (!nodes.length) return;
      var text = Array.prototype.map.call(nodes, function (n) {
        return n.textContent;
      }).join('').trim();
      if (!text || text === _lastText) return;
      _lastText = text;
      da.emit('subtitles', [{ text: text, language: cfg.language, start: 0, end: 0 }]);
    } catch (e) {
      da.log('error', 'subtitle', String(e));
    }
  }

  // ── Playback clock (generic <video>) ────────────────────────────────────────
  // Emitted regardless of the captions setting, so externally pulled subtitles
  // stay in sync even when the page has no captions of its own.

  function emitClock() {
    if (!_video) return;
    da.emit('playback', {
      currentTime: _video.currentTime,
      duration: _video.duration,
      playing: !_video.paused,
    });
  }

  function wireVideo() {
    var v = document.querySelector('video');
    if (!v || v === _video) return;
    _video = v;
    v.addEventListener('timeupdate', emitClock);
    v.addEventListener('play', emitClock);
    v.addEventListener('pause', emitClock);
    v.addEventListener('seeked', emitClock);
    emitClock();
  }

  da.register('play', function () { if (_video) _video.play(); });
  da.register('pause', function () { if (_video) _video.pause(); });
  da.register('seek', function (args) {
    if (_video && args && typeof args.to === 'number') _video.currentTime = args.to / 1000;
  });

  // ── Observe the page for late-loading captions / video ──────────────────────
  // Runs unconditionally: it also (re)finds the <video> for the clock.

  function onMutation() {
    wireVideo();
    readAndEmit();
  }

  da.onSettingsChanged(function (s) {
    cfg.enabled = !!s.enabled;
    cfg.language = s.language || 'ja';
    readAndEmit();
  });

  da.register('get', function () {
    try {
      var nodes = document.querySelectorAll(SELECTOR);
      return Array.prototype.map.call(nodes, function (n) {
        return { text: n.textContent, language: cfg.language };
      });
    } catch (e) {
      da.log('error', 'subtitle', String(e));
      return [];
    }
  });

  _observer = new MutationObserver(onMutation);
  _observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  wireVideo();
})();
