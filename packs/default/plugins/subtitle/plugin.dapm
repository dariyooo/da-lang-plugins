{
  "id": "da.default.subtitle",
  "name": "YouTube Subtitles",
  "version": "0.3.0",
  "runtime": "webview",
  "family": "browserPlugin",
  "needs": {},
  "kind": "subtitle",
  "description": "Reads .ytp-caption-segment nodes on YouTube and emits subtitles via da.emit('subtitles'), and emits the <video> clock via da.emit('playback') so externally pulled subtitles stay in sync. Registers play/pause/seek handlers so the app can control playback.",
  "author": "DaLang",
  "hosts": ["*youtube.com*", "*youtu.be*"],
  "settings": [
    {
      "key": "enabled",
      "type": "bool",
      "label": "Enable subtitles",
      "description": "Capture live subtitle text from the YouTube player and forward it to the app.",
      "default": true
    },
    {
      "key": "language",
      "type": "choice",
      "label": "Subtitle language",
      "description": "Only forward subtitles that match this language track. Other tracks are ignored.",
      "options": ["ja", "zh", "ko", "en"],
      "default": "ja"
    }
  ]
}
