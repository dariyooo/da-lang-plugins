{
  "id": "da.default.subtitle",
  "name": "YouTube Subtitles",
  "version": "0.5.0",
  "runtime": "webview",
  "family": "browserPlugin",
  "needs": { "language": 1 },
  "kind": "subtitle",
  "description": "Lists YouTube's caption tracks — every language, manual and auto-generated — reads the line on screen, and emits the <video> clock plus play/pause/seek so the app controls playback. Captions render with YouTube's own token, hidden behind the app's overlay.",
  "author": "DaLang",
  "hosts": ["*youtube.com*", "*youtu.be*"],
  "settings": [
    {
      "key": "onlyStudyLanguage",
      "type": "bool",
      "label": "Only my study language",
      "description": "Show only subtitle tracks in the language you're studying. Turn off to pick any available language.",
      "default": true
    },
    {
      "key": "autoEnable",
      "type": "bool",
      "label": "Auto-show subtitles",
      "description": "Show a video's subtitles automatically when one is available, without opening the picker.",
      "default": true
    }
  ]
}
