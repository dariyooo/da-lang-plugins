// AniList tracker (https://anilist.co) — search a series, read the linked entry,
// and sync reading/watching progress. OAuth via `da.host.auth`; the token is
// kept in `da.host.secrets`. Talks to the AniList GraphQL API
// (https://docs.anilist.co). Written from the public API; verify against a live
// account.
//
// Requires DaKanji's registered AniList OAuth app id below and a matching
// `<scheme>://anilist-auth` redirect URI on that app.
const GRAPHQL = "https://graphql.anilist.co";
const CLIENT_ID = "REPLACE_WITH_DAKANJI_ANILIST_CLIENT_ID"; // TODO: DaKanji's AniList app id
const TOKEN_KEY = "anilist_token";

class TrackerFetchPlugin {
  _token() {
    return da.host.secrets.get(TOKEN_KEY);
  }

  async _gql(query, variables, auth) {
    const headers = { "Content-Type": "application/json", "Accept": "application/json" };
    if (auth) {
      const t = await this._token();
      if (t) headers["Authorization"] = "Bearer " + t;
    }
    const res = await new Client().post(GRAPHQL, headers, JSON.stringify({ query: query, variables: variables }));
    return JSON.parse(res.body);
  }

  // comic / book -> MANGA, video -> ANIME on AniList.
  _mediaType(kind) {
    return kind === "video" ? "ANIME" : "MANGA";
  }

  async authenticate() {
    const scheme = await da.host.auth.callbackScheme();
    const redirect = scheme + "://anilist-auth";
    const url =
      "https://anilist.co/api/v2/oauth/authorize?client_id=" + CLIENT_ID +
      "&response_type=token&redirect_uri=" + encodeURIComponent(redirect);
    const result = await da.host.auth.redirect(url);
    // Implicit grant returns the token in the URL fragment: #access_token=...
    const frag = (result.split("#")[1] || "");
    const params = {};
    frag.split("&").forEach(function (p) {
      const kv = p.split("=");
      params[kv[0]] = decodeURIComponent(kv[1] || "");
    });
    if (!params.access_token) return false;
    await da.host.secrets.set(TOKEN_KEY, params.access_token);
    return true;
  }

  // AniList implicit-grant tokens are long-lived and carry no refresh token; the
  // session is valid as long as one is stored.
  async refreshToken() {
    return !!(await this._token());
  }

  async search(title, kind) {
    const q =
      "query ($search: String, $type: MediaType) {" +
      "  Page(perPage: 20) { media(search: $search, type: $type) {" +
      "    id title { romaji english } coverImage { medium }" +
      "    chapters episodes description(asHtml: false) siteUrl } } }";
    const data = await this._gql(q, { search: title, type: this._mediaType(kind) }, false);
    const media = ((data.data || {}).Page || {}).media || [];
    return media.map(function (m) {
      return {
        id: String(m.id),
        title: (m.title.english || m.title.romaji || ""),
        coverUrl: (m.coverImage || {}).medium || null,
        totalChapters: m.chapters || m.episodes || null,
        trackingUrl: m.siteUrl || null,
        summary: m.description || null,
      };
    });
  }

  async getEntry(mediaId, kind) {
    const q =
      "query ($mediaId: Int) { MediaList(mediaId: $mediaId) {" +
      "  progress score(format: POINT_100) status" +
      "  startedAt { year month day } completedAt { year month day }" +
      "  media { chapters episodes siteUrl } } }";
    const data = await this._gql(q, { mediaId: parseInt(mediaId, 10) }, true);
    const e = (data.data || {}).MediaList;
    return e ? this._toState(e) : null;
  }

  async sync(mediaId, state, kind) {
    const q =
      "mutation ($mediaId: Int, $progress: Int, $status: MediaListStatus, $score: Float) {" +
      "  SaveMediaListEntry(mediaId: $mediaId, progress: $progress, status: $status, scoreRaw: $score) {" +
      "    progress score(format: POINT_100) status" +
      "    startedAt { year month day } completedAt { year month day }" +
      "    media { chapters episodes siteUrl } } }";
    const data = await this._gql(q, {
      mediaId: parseInt(mediaId, 10),
      progress: state.progress,
      status: this._toAniListStatus(state.status),
      score: state.score,
    }, true);
    return this._toState((data.data || {}).SaveMediaListEntry || {});
  }

  async userList(kind) {
    const viewer = await this._gql("query { Viewer { id } }", {}, true);
    const uid = ((viewer.data || {}).Viewer || {}).id;
    if (!uid) return [];
    const q =
      "query ($userId: Int, $type: MediaType) {" +
      "  MediaListCollection(userId: $userId, type: $type) { lists { entries {" +
      "    progress score(format: POINT_100) status" +
      "    media { id title { romaji english } coverImage { medium } chapters episodes siteUrl }" +
      "  } } } }";
    const data = await this._gql(q, { userId: uid, type: this._mediaType(kind) }, true);
    const lists = ((data.data || {}).MediaListCollection || {}).lists || [];
    const self = this;
    const out = [];
    lists.forEach(function (l) {
      (l.entries || []).forEach(function (e) {
        const m = e.media || {};
        out.push({
          id: String(m.id),
          title: (m.title.english || m.title.romaji || ""),
          coverUrl: (m.coverImage || {}).medium || null,
          totalChapters: m.chapters || m.episodes || null,
          trackingUrl: m.siteUrl || null,
          progress: e.progress || null,
          score: e.score || null,
          status: self._fromAniListStatus(e.status),
        });
      });
    });
    return out;
  }

  statusList(kind) {
    return ["current", "planned", "completed", "onHold", "dropped", "repeating"];
  }

  // AniList stores scores as 0-100 internally (POINT_100); the app renders them.
  scoreFormat() {
    return { max: 100, step: 1, kind: "point" };
  }

  dispose() {}

  _toState(e) {
    const m = e.media || {};
    return {
      progress: e.progress || null,
      totalChapters: m.chapters || m.episodes || null,
      score: e.score || null,
      status: this._fromAniListStatus(e.status),
      startedDate: this._date(e.startedAt),
      finishedDate: this._date(e.completedAt),
      trackingUrl: m.siteUrl || null,
    };
  }

  _date(d) {
    if (!d || !d.year) return null;
    return Date.UTC(d.year, (d.month || 1) - 1, d.day || 1);
  }

  _fromAniListStatus(s) {
    switch (s) {
      case "CURRENT": return "current";
      case "PLANNING": return "planned";
      case "COMPLETED": return "completed";
      case "PAUSED": return "onHold";
      case "DROPPED": return "dropped";
      case "REPEATING": return "repeating";
      default: return null;
    }
  }

  _toAniListStatus(s) {
    switch (s) {
      case "current": return "CURRENT";
      case "planned": return "PLANNING";
      case "completed": return "COMPLETED";
      case "onHold": return "PAUSED";
      case "dropped": return "DROPPED";
      case "repeating": return "REPEATING";
      default: return null;
    }
  }
}
